DATABASE_URL=postgresql://classroom:classroom_local@127.0.0.1:55432/classroom?schema=public
API_PORT=3001
API_HOST=127.0.0.1
HEARTBEAT_TIMEOUT_MS=15000
AWAY_TIMEOUT_MS=120000

# Shared by the API and standalone device simulators. Default NetsBlox editor uses this host.
NETSBLOX_SERVICES_URL=https://services.netsblox.org
# Optional simulator UDP overrides: IOTSCAPE_PORT, ROBOSCAPE_PORT (default 1973)

# local simulator discovery stay testing only and disabled by default
LOCAL_DEVICE_TESTING=false
# use the same port in independent test simulators
DEVICE_PROVISIONING_PORT=41234


TEACHER_CLOSE_ON_EXIT=true
